{
  "name": "ui-reference-bank-dashboard",
  "private": true,
  "type": "module",
  "scripts": {
    "catalog:build": "node tools/ui-bank.mjs build",
    "catalog:check": "node tools/ui-bank.mjs check",
    "catalog:test": "node --test tools/ui-bank.test.mjs",
    "icons:import": "node tools/import-animated-icons.mjs",
    "icons:check": "node tools/import-animated-icons.mjs --check",
    "skill:install": "node tools/install-ui-bank-skill.mjs",
    "dev": "node node_modules/vite/bin/vite.js",
    "dev:personal": "UI_BANK_PERSONAL=1 node node_modules/vite/bin/vite.js",
    "build": "npm run catalog:check && node --max-old-space-size=8192 node_modules/vite/bin/vite.js build",
    "preview": "node node_modules/vite/bin/vite.js preview"
  },
  "dependencies": {
    "@sveltejs/vite-plugin-svelte": "^5.1.1",
    "@vitejs/plugin-vue": "^5.2.4",
    "clsx": "^2.1.1",
    "d3-scale": "^4.0.2",
    "d3-shape": "^3.2.0",
    "flubber": "^0.4.2",
    "glimm": "*",
    "iconoir-react": "^7.11.0",
    "liveline": "*",
    "lottie-web": "^5.13.0",
    "motion": "^11.15.0",
    "motion-v": "^2.3.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "svelte": "^5.56.9",
    "tailwind-merge": "^2.6.0",
    "three": "^0.171.0",
    "tinted": "*",
    "vue": "^3.5.41"
  },
  "devDependencies": {
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "^5.7.2",
    "vite": "^6.0.7"
  }
}
